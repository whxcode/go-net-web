# =============================================================================
#  部署配置：一般只需要改第一行的 WEB_PORT，其余保持默认即可
#  改完执行： docker compose up -d      （compose 会自动重建受影响的容器）
# =============================================================================

# 【要改的就是这一行】网站对外端口。
# 换成你服务器上没被占用的端口，例如 8080 / 9000 / 18081。
# 之后访问地址就是： http://你的服务器IP:这个端口
# 前端所有请求都是相对路径，所以改端口不需要重新构建前端。
WEB_PORT=8081

# ---------------------------------------------------------------------------
# 数据库密码（可选，不打算改就别动）
# 如果改这里，必须同时改 backend/config.json 里的 database.password，保持一致，
# 否则后端连不上数据库。已经启动过再改密码是不会生效的（密码存在数据卷里），
# 要生效得先 docker compose down -v 再起来。
MYSQL_ROOT_PASSWORD=123456

# 数据库名（保持 go-net 不要改，init.sql 里写死了这个库名）
MYSQL_DATABASE=go-net
